# Navigation
alias dl='cd ~/Downloads'
alias docs='cd ~/Documents'

alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# Listing
alias l='ls -lh'
alias ll='ls -alh'
alias la='ls -Ahl'
alias ls='ls --color=auto'

# Tooling
alias reload='exec fish'
alias dotfiles='zed (chezmoi source-path)'

# Utils
alias path='printf "%s\n" $PATH'
alias z='zed .'
alias v='vek'

