{
  "theme": {
    "mode": "system",
    "light": "Gruvbox Light Hard",
    "dark": "Gruvbox Dark Hard"
  },

  "theme_overrides": {
    "Gruvbox Light Hard": {
      "syntax": {
        "comment": {
          "font_style": "italic"
        },
        "comment.doc": {
          "font_style": "italic"
        }
      }
    },

    "Gruvbox Dark Hard": {
      "syntax": {
        "comment": {
          "font_style": "italic"
        },
        "comment.doc": {
          "font_style": "italic"
        }
      }
    }
  },

  "icon_theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha"
  },

  "buffer_font_family": "JetBrains Mono",
  "buffer_font_size": 15,

  "cli_default_open_behavior": "existing_window",

  "soft_wrap": "none",

  "preferred_line_length": 100,
  "wrap_guides": [100],
  "show_wrap_guides": true,

  "format_on_save": "on",
  "remove_trailing_whitespace_on_save": true,
  "ensure_final_newline_on_save": true,

  "show_whitespaces": "selection",

  "colorize_brackets": true,

  "relative_line_numbers": "enabled",

  "terminal": {
    "font_family": "JetBrains Mono",
    "font_size": 15,
    "line_height": "standard"
  },

  "languages": {
    "HTML": {
      "tab_size": 2,
      "hard_tabs": false
    },
    "CSS": {
      "tab_size": 2,
      "hard_tabs": false,
      "language_servers": ["tailwindcss-intellisense-css", "!vscode-css-language-server", "..."]
    },
    "JavaScript": {
      "tab_size": 2,
      "hard_tabs": false
    },
    "TypeScript": {
      "tab_size": 2,
      "hard_tabs": false
    },
    "JSON": {
      "tab_size": 2,
      "hard_tabs": false
    },
    "YAML": {
      "tab_size": 2,
      "hard_tabs": false
    },
    "Markdown": {
      "soft_wrap": "editor_width"
    },
    "AsciiDoc": {
      "soft_wrap": "editor_width"
    }
  },

  "minimap": {
    "show": "never"
  },

  "indent_guides": {
    "enabled": true,
    "coloring": "fixed"
  },

  "file_finder": {
    "modal_max_width": "large"
  },

  "resize_all_panels_in_dock": ["right"],

  "project_panel": {
    "dock": "right",
    "default_width": 340,
    "entry_spacing": "comfortable",
    "auto_fold_dirs": true,
    "auto_reveal_entries": false,
    "bold_folder_labels": true,
    "git_status": true,
    "git_status_indicator": true,
    "sticky_scroll": true,
    "scrollbar": {
      "show": "never"
    },
    "indent_guides": {
      "show": "always"
    }
  },

  "outline_panel": {
    "default_width": 300,

    "indent_guides": {
      "show": "always"
    }
  },

  "git_panel": {
    "dock": "right",
    "default_width": 340,
    "tree_view": true,
    "folder_icons": false,
    "group_by": "staging"
  },

  "agent": {
    "dock": "left",
    "default_width": 540,
    "flexible": false
  },

  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "reasoning_effort": "medium",
        "mode": "auto"
      },
      "type": "registry"
    }
  },

  "auto_install_extensions": {
    "html": true,
    "git-firefly": true,
    "toml": true,
    "dockerfile": true,
    "sql": true,
    "vue": true,
    "catppuccin-icons": true,
    "csharp": false,
    "astro": true,
    "ini": true,
    "fish": true,
    "just": true,
    "templ": true,
    "asciidoc": true,
    "opentofu": true
  }
}
