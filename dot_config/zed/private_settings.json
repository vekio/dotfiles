{
  "ui_font_size": 16,
  "buffer_font_size": 15,

  "cli_default_open_behavior": "existing_window",

  "soft_wrap": "editor_width",
  "format_on_save": "on",

  "relative_line_numbers": "enabled",
  "remove_trailing_whitespace_on_save": true,

  "minimap": {
    "show": "always"
  },

  "theme": {
    "mode": "system",
    "light": "Gruvbox Light Hard",
    "dark": "Gruvbox Dark Hard"
  },

  "icon_theme": {
    "mode": "system",
    "light": "Catppuccin Mocha",
    "dark": "Catppuccin Mocha"
  },

  "resize_all_panels_in_dock": ["right"],

  "project_panel": {
    "dock": "right",
    "default_width": 340,
    "git_status": true,
    "git_status_indicator": true
  },

  "git_panel": {
    "dock": "right",
    "default_width": 340,
    "tree_view": true,
    "group_by": "none"
  },

  "agent": {
    "dock": "left",
    "default_width": 600,
    "flexible": false,
    "commit_message_instructions": "Use Conventional Commits format: <type>(<scope>): <description>. Keep the subject concise."
  },

  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "reasoning_effort": "medium",
        "mode": "auto"
      },
      "type": "registry"
    }
  },

  "auto_install_extensions": {
    "html": true,
    "git-firefly": true,
    "toml": true,
    "sql": true,
    "vue": true,
    "catppuccin-icons": true,
    "catppuccin": true,
    "csharp": false,
    "astro": true,
    "ini": true,
    "fish": true,
    "just": true,
    "asciidoc": true,
    "opentofu": true
  }
}
