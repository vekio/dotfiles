{
  "theme": {
    "mode": "system",
    "light": "Gruvbox Light Hard",
    "dark": "Gruvbox Dark Hard"
  },

  "theme_overrides": {
    "Gruvbox Light Hard": {
      "syntax": {
        "comment": { "font_style": "italic" },
        "comment.doc": { "font_style": "italic" }
      }
    },
    "Gruvbox Dark Hard": {
      "syntax": {
        "comment": { "font_style": "italic" },
        "comment.doc": { "font_style": "italic" }
      }
    }
  },

  "icon_theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha"
  },

  "ui_font_family": ".ZedSans",
  "ui_font_size": 16,
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_size": 14,

  "cli_default_open_behavior": "existing_window",

  "soft_wrap": "editor_width",
  "format_on_save": "on",

  "relative_line_numbers": "enabled",
  "remove_trailing_whitespace_on_save": true,

  "terminal": {
    "font_family": "JetBrainsMono Nerd Font Mono",
    "font_size": 13
  },

  "languages": {
    "HTML": {
      "tab_size": 2,
      "hard_tabs": false
    },
    "CSS": {
      "tab_size": 2,
      "hard_tabs": false,
      "language_servers": [
        "tailwindcss-intellisense-css",
        "!vscode-css-language-server",
        "..."
      ]
    },
    "JavaScript": {
      "tab_size": 2,
      "hard_tabs": false
    }
  },

  "minimap": {
    "show": "always"
  },

  "resize_all_panels_in_dock": ["right"],

  "project_panel": {
    "dock": "right",
    "default_width": 340,
    "git_status": true,
    "git_status_indicator": true
  },

  "git_panel": {
    "dock": "right",
    "default_width": 340,
    "tree_view": true,
    "group_by": "none"
  },

  "agent": {
    "dock": "left",
    "default_width": 600,
    "flexible": false,
    "commit_message_instructions": "Use Conventional Commits format: <type>(<scope>): <description>. Keep the subject concise."
  },

  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "reasoning_effort": "medium",
        "mode": "auto"
      },
      "type": "registry"
    }
  },

  "auto_install_extensions": {
    "html": true,
    "git-firefly": true,
    "toml": true,
    "dockerfile": true,
    "sql": true,
    "vue": true,
    "catppuccin-icons": true,
    "csharp": false,
    "astro": true,
    "ini": true,
    "fish": true,
    "just": true,
    "templ": true,
    "asciidoc": true,
    "opentofu": true
  }
}
